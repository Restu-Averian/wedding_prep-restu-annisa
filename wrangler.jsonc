{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding-planner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "vars": { "LOCAL_DEVELOPMENT": "false" },
  "d1_databases": [{ "binding": "DB", "database_name": "wedding-planner-db", "database_id": "fb6e0255-db81-4eac-b6e1-39001a63a2ff", "migrations_dir": "migrations" }]
}
