{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding-planner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "vars": {
    "LOCAL_DEVELOPMENT": "false",
  },
  "r2_buckets": [
    {
      "binding": "INVOICES",
      "bucket_name": "wedding-planner-invoices",
    },
    {
      "bucket_name": "wedding-planner-invoices",
      "binding": "wedding_planner_invoices",
      "remote": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wedding-planner-db",
      "database_id": "fb6e0255-db81-4eac-b6e1-39001a63a2ff",
      "migrations_dir": "migrations",
    },
  ],
}
